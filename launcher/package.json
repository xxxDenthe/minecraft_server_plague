{
  "name": "plague-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Лаунчер сессионного сервера «Чума»",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
