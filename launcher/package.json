    "manifest": "node tools/build-manifest.js",
    "publish": "node tools/publish-pack.js",
    "configure": "node tools/configure.js",
    "check-access": "node tools/check-access.js"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron@44.1.1": true
  }
}
