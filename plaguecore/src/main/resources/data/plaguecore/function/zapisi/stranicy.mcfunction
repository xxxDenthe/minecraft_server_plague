give @s plaguecore:archive_record[minecraft:custom_model_data=1,minecraft:written_book_content={title:"Бумаги управы, IX",author:"рука писаря",pages:['{"text": "", "extra": [{"text": "Бумаги управы, IX\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "В старых бумагах нашлась странная запись.\\n\\n"}, {"text": "Она не объясняла, что искать."}]}','{"text": "", "extra": [{"text": "Только указывала направление.\\n\\n"}, {"text": "От сломанной звонницы к белому валуну — прямая.\\n\\n"}, {"text": "Мы не поняли, зачем это написано."}]}','{"text": "", "extra": [{"text": "Но тот, кто оставил запись, не раз поминал старые карты.\\n\\n"}, {"text": "Должно быть, он уже знал, что заражённая земля уходит далеко вниз.\\n\\n"}, {"text": "рука писаря", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=2,minecraft:written_book_content={title:"Тетрадь часовни, X",author:"рука неизвестная",pages:['{"text": "", "extra": [{"text": "Тетрадь часовни, X\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "В старой часовне сохранилась другая запись.\\n\\n"}, {"text": "В ней говорилось о месте, которого из деревни не видно."}]}','{"text": "", "extra": [{"text": "От сухостоя к старой переправе — прямая.\\n\\n"}, {"text": "Ниже приписано:\\n\\n"}, {"text": "Если первая линия ведёт к старой земле, вторая покажет, где искать глубже."}]}','{"text": "", "extra": [{"text": "Тогда мы ещё не понимали, что речь не о земле.\\n\\n"}, {"text": "Речь о том, что выросло под ней.\\n\\n"}, {"text": "рука неизвестная", "italic": true, "color": "#6a5c49"}]}']}]
