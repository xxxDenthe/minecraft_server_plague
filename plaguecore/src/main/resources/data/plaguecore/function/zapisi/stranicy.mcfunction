give @s plaguecore:archive_record[minecraft:custom_model_data=2,minecraft:written_book_content={title:"Тетрадь часовни, XII",author:"рука неизвестная",pages:['{"text": "", "extra": [{"text": "Тетрадь часовни, XII\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Теперь мы знаем, откуда оно пришло.\\n\\n"}, {"text": "Оно было здесь всегда.\\n\\n"}, {"text": "Мы его не создали."}]}','{"text": "", "extra": [{"text": "Но всё остальное сделали мы.\\n\\n"}, {"text": "Мы осушили землю.\\n\\n"}, {"text": "Мы перенесли заражённую почву.\\n\\n"}, {"text": "Мы собрали отходы в одном месте."}]}','{"text": "", "extra": [{"text": "Мы снова развезли их по полям.\\n\\n"}, {"text": "Мы не заметили перемены.\\n\\n"}, {"text": "Потом пришёл дождь.\\n\\n"}, {"text": "Потом заболели люди."}]}','{"text": "", "extra": [{"text": "А когда мы поняли, гриб был уже под деревней.\\n\\n"}, {"text": "Если вы это читаете — значит, оно ещё живо."}]}','{"text": "", "extra": [{"text": "И если Сердце там, где мы думаем, его можно убить.\\n\\n"}, {"text": "Но сперва надо понять, как до него добраться.\\n\\n"}, {"text": "рука неизвестная", "italic": true, "color": "#6a5c49"}]}']}]
