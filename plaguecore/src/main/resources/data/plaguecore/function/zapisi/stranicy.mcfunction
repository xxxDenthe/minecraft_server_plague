give @s plaguecore:archive_record[minecraft:custom_model_data=1,minecraft:written_book_content={title:"Бумаги управы, I",author:"рука писаря",pages:['{"text": "", "extra": [{"text": "Бумаги управы, I\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Вода стояла здесь дольше, чем помнили старики.\\n\\n"}, {"text": "Весной сюда не проезжала телега."}]}','{"text": "", "extra": [{"text": "На сухом краю росла трава, а ближе к воде земля была в сером налёте.\\n\\n"}, {"text": "Тогда никто не думал, что это важно."}]}','{"text": "", "extra": [{"text": "Нам казалось: убери воду — и место станет как все прочие.\\n\\n"}, {"text": "Но под землёй осталось то, чего мы не видели."}]}','{"text": "", "extra": [{"text": "Старый канал вёл воду дальше.\\n\\n"}, {"text": "На краю стояла деревянная избушка.\\n\\n"}, {"text": "Рядом лежал разбитый плуг.\\n\\n"}, {"text": "рука писаря", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=2,minecraft:written_book_content={title:"Тетрадь часовни, II",author:"рука лекаря",pages:['{"text": "", "extra": [{"text": "Тетрадь часовни, II\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Старики звали её серой плесенью.\\n\\n"}, {"text": "Она появлялась после дождя и иногда сходила сама."}]}','{"text": "", "extra": [{"text": "В один год была почти белой, в другой — тёмной.\\n\\n"}, {"text": "Иные пятна высыхали за неделю.\\n\\n"}, {"text": "Иные возвращались с первым дождём."}]}','{"text": "", "extra": [{"text": "Мы думали, что это разные грибы.\\n\\n"}, {"text": "Никто не проверял.\\n\\n"}, {"text": "В сарае осталась старая корзина.\\n\\n"}, {"text": "На полке стояла пустая банка."}]}','{"text": "", "extra": [{"text": "В углу лежало опрокинутое лукошко.\\n\\n"}, {"text": "рука лекаря", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=3,minecraft:written_book_content={title:"Журнал дренажа, III",author:"рука землекопа",pages:['{"text": "", "extra": [{"text": "Журнал дренажа, III\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Мы копали канавы всё лето.\\n\\n"}, {"text": "Вода уходила медленно."}]}','{"text": "", "extra": [{"text": "Землю вывозили туда, где раньше ничего не росло.\\n\\n"}, {"text": "Работали быстро: хотели успеть до осени."}]}','{"text": "", "extra": [{"text": "Никто не думал, что земля переносит болезнь.\\n\\n"}, {"text": "В ней не было ни крови, ни запаха.\\n\\n"}, {"text": "Только серый налёт."}]}','{"text": "", "extra": [{"text": "От межи до воды намерили сорок сажен.\\n\\n"}, {"text": "Внизу под дёрном шёл тяжёлый суглинок."}]}','{"text": "", "extra": [{"text": "Он держал воду хуже, чем нам обещали.\\n\\n"}, {"text": "рука землекопа", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=1,minecraft:written_book_content={title:"Бумаги управы, IV",author:"рука мельника",pages:['{"text": "", "extra": [{"text": "Бумаги управы, IV\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Через несколько лет зерно стало портиться прямо в амбарах.\\n\\n"}, {"text": "Мы потеряли больше половины."}]}','{"text": "", "extra": [{"text": "Выбрасывать было жалко.\\n\\n"}, {"text": "Тогда решили свезти отходы в одно место.\\n\\n"}, {"text": "Навоз. Солому. Опилки. Порченое зерно."}]}','{"text": "", "extra": [{"text": "Свезли туда, где раньше стояла вода.\\n\\n"}, {"text": "Мякину сгребали туда же, возами.\\n\\n"}, {"text": "Думали, за зиму выйдет перегной и весной вернём его на поля."}]}','{"text": "", "extra": [{"text": "Куча была горячей внутри и холодной снаружи.\\n\\n"}, {"text": "Тот неурожай мы поминали ещё долго.\\n\\n"}, {"text": "рука мельника", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=3,minecraft:written_book_content={title:"Журнал дренажа, V",author:"рука землекопа",pages:['{"text": "", "extra": [{"text": "Журнал дренажа, V\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Через несколько недель куча начала оседать.\\n\\n"}, {"text": "Сверху подсыхало, внутри оставалось влажно и горячо."}]}','{"text": "", "extra": [{"text": "Потом пошёл дождь.\\n\\n"}, {"text": "Через день снова вышло солнце.\\n\\n"}, {"text": "Так повторялось много раз.\\n\\n"}, {"text": "Зимой ударила оттепель, и всё потекло опять."}]}','{"text": "", "extra": [{"text": "Большая часть серой плесени пропала.\\n\\n"}, {"text": "Но кое-что осталось.\\n\\n"}, {"text": "То, что осталось, росло быстрее прежнего."}]}','{"text": "", "extra": [{"text": "Оно не боялось сухой земли и шло в корни.\\n\\n"}, {"text": "На старом поле так и стояла брошенная борона.\\n\\n"}, {"text": "рука землекопа", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=2,minecraft:written_book_content={title:"Тетрадь часовни, VI",author:"рука мельника",pages:['{"text": "", "extra": [{"text": "Тетрадь часовни, VI\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "Первое растение погибло незаметно.\\n\\n"}, {"text": "Потом второе.\\n\\n"}, {"text": "Мы думали, виновата почва."}]}','{"text": "", "extra": [{"text": "Когда выкопали корень, увидели серые нити.\\n\\n"}, {"text": "Они шли глубже.\\n\\n"}, {"text": "Там, где стебель был ещё зелёным, корневище уже было тронуто."}]}','{"text": "", "extra": [{"text": "По осени на стерне серые пятна стояли до самого снега.\\n\\n"}, {"text": "Никто не знал, насколько далеко всё это ушло.\\n\\n"}, {"text": "рука мельника", "italic": true, "color": "#6a5c49"}]}']}]
give @s plaguecore:archive_record[minecraft:custom_model_data=3,minecraft:written_book_content={title:"Журнал дренажа, VII",author:"рука землекопа",pages:['{"text": "", "extra": [{"text": "Журнал дренажа, VII\\n", "bold": true}, {"text": "———————————\\n\\n", "color": "#6a5c49"}, {"text": "В этот год дождь пришёл раньше.\\n\\n"}, {"text": "Старые канавы снова налились водой.\\n\\n"}, {"text": "Землю размывало."}]}','{"text": "", "extra": [{"text": "Серые пятна вышли там, где их не было никогда.\\n\\n"}, {"text": "Люди несли грязь на обуви.\\n\\n"}, {"text": "Лошади тянули её по дорогам."}]}','{"text": "", "extra": [{"text": "Вода уносила дальше.\\n\\n"}, {"text": "Весь дренаж, что мы клали семь лет назад, работал теперь наоборот.\\n\\n"}, {"text": "Низина снова собирала всё в себя."}]}','{"text": "", "extra": [{"text": "Мы видели, как один участок сходится с другим.\\n\\n"}, {"text": "И всё ещё думали, что это можно остановить.\\n\\n"}, {"text": "рука землекопа", "italic": true, "color": "#6a5c49"}]}']}]
